{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beeline-technologies.example/schemas/discovery-manifest.schema.json",
  "title": "Governed Exploratory Development Discovery Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "project",
    "repository_name",
    "created_at",
    "status",
    "governance",
    "workflow",
    "discovery_repo"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DISC-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository_name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "active",
        "closed"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "submodule_path",
        "reading_scope",
        "reading_scope_record"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "submodule_path": {
          "const": ".governance"
        },
        "reading_scope": {
          "enum": [
            "full",
            "curated"
          ]
        },
        "reading_scope_record": {
          "const": "GOVERNANCE-READING-SCOPE.yaml"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketplace",
        "plugin",
        "version"
      ],
      "properties": {
        "marketplace": {
          "const": "Beeline-Technologies"
        },
        "plugin": {
          "const": "governed-exploratory-development"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "discovery_repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "framing",
        "product_access",
        "question",
        "success_criteria",
        "non_goals",
        "comparison",
        "derived_from",
        "successor_reason"
      ],
      "properties": {
        "type": {
          "enum": [
            "architecture-candidate",
            "spike",
            "prototype-poc",
            "benchmark",
            "compatibility-check",
            "adversarial-investigation",
            "other"
          ]
        },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "objective"
          ],
          "properties": {
            "mode": {
              "enum": [
                "neutral",
                "optimize-quality",
                "challenge-assumptions",
                "custom"
              ]
            },
            "objective": {
              "type": "string"
            }
          }
        },
        "product_access": {
          "enum": [
            "isolated",
            "contract-aware",
            "full-reference"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target",
                "dimensions"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "product",
                    "discovery-repo",
                    "discovery-report",
                    "metric-baseline"
                  ]
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "dimensions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "derived_from": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^DISC-[0-9]{4,}$"
            }
          ]
        },
        "successor_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "derived_from": {
                "type": "string"
              }
            },
            "required": [
              "derived_from"
            ]
          },
          "then": {
            "properties": {
              "successor_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
